DATA;
#1 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#2);
#2 = APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#3 = SHAPE_DEFINITION_REPRESENTATION(#4,#10);
#4 = PRODUCT_DEFINITION_SHAPE('','',#5);
#5 = PRODUCT_DEFINITION('design','',#6,#9);
#6 = PRODUCT_DEFINITION_FORMATION('','',#7);
#7 = PRODUCT('LibertyBot_Assembly','LibertyBot_Assembly','',(#8));
#8 = PRODUCT_CONTEXT('',#2,'mechanical');
#9 = PRODUCT_DEFINITION_CONTEXT('part definition',#2,'design');
#10 = ADVANCED_BREP_SHAPE_REPRESENTATION('LibertyBot_Assembly',(#11,#15),#19);
#11 = MANIFOLD_SOLID_BREP('Torso_And_Head_Shell',#12);
#12 = CLOSED_SHELL('',(#13));
#13 = ADVANCED_FACE('',(#14),#16,.T.);
#14 = FACE_OUTER_BOUND('',#17,.T.);
#15 = AXIS2_PLACEMENT_3D('',#18,#20,#21);
#16 = PLANE('',#15);
#17 = EDGE_LOOP('',());
#18 = CARTESIAN_POINT('',(0.0,0.0,0.0));
#19 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#22)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#23,#24,#25)) REPRESENTATION_CONTEXT('Context #1','3D Context with UNIT and UNCERTAINTY') );
#20 = DIRECTION('',(0.0,0.0,1.0));
#21 = DIRECTION('',(1.0,0.0,0.0));
